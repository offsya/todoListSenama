# API base URL. In development it can stay unset: the app then uses port 4000 on the computer
# running the Expo dev server (the host the phone already reaches for the JS bundle), or
# localhost on the web and in simulators.
#
# Set it when that guess cannot work:
#   - release/preview builds (required — the app refuses to start without it);
#   - `expo start --tunnel` (the tunnel does not forward the API port);
#   - a phone on another network, or a deployed API.
#
# Release builds on Android block plain http:// — use https:// for anything but local testing.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
