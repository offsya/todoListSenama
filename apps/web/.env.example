# Where the web app sends API requests. Defaults to "/api", which the Vite dev server
# (and `vite preview`) proxies to http://localhost:4000 — no CORS setup needed.
# Set an absolute URL for other setups, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=/api

# Where the dev proxy forwards /api (read in vite.config.ts, never exposed to the browser)
# API_PROXY_TARGET=http://localhost:4000
