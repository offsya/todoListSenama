{
  "name": "@todo/web",
  "version": "1.0.0",
  "private": true,
  "description": "Web client for the todo app: React + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build -w @todo/shared && npm run build -w @todo/client",
    "typecheck": "tsc -b",
    "pretest": "npm run build -w @todo/shared && npm run build -w @todo/client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@todo/client": "*",
    "@todo/shared": "*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
