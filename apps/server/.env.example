NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app

# Secret for signing access tokens, at least 32 characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Token lifetime: 15m, 12h, 7d, ...
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API (web app, Expo web)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional
# BCRYPT_ROUNDS=10
# AUTH_RATE_LIMIT_MAX=20
# TRUST_PROXY=1
