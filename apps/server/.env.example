NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app

# Secret for signing access tokens, at least 32 characters. The value below is for local
# development only (the API refuses to start with it in production). Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Token lifetime: 15m, 12h, 7d, ...
JWT_EXPIRES_IN=15m

# Comma-separated list of browser origins allowed to call the API (web app, Expo web)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Todo attachments: a private S3 bucket and its region. Without S3_BUCKET the attachment routes
# answer 503. AWS credentials are not set here: on EC2 the instance role provides them; locally
# the AWS SDK reads AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or an ~/.aws profile.
# S3_BUCKET=todo-attachments-example
# AWS_REGION=eu-central-1

# Optional
# HOST=127.0.0.1
# PASSWORD_HASH_COST=15
# AUTH_RATE_LIMIT_MAX=20
# TODOS_RATE_LIMIT_MAX=300
# TRUST_PROXY=1
