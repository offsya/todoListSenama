{
  "name": "@todo/client",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side logic shared by the web and mobile apps: session store and React Query hooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "pretypecheck": "npm run build -w @todo/shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @todo/shared",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@todo/shared": "*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.18",
    "jsdom": "^30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
