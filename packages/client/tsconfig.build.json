{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // No DOM types for the shipped code: it also runs in React Native, where `window` and
    // `localStorage` do not exist. Tests (jsdom) keep DOM through tsconfig.json.
    "lib": ["ES2022"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
