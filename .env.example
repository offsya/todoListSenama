# Optional settings for docker-compose.yml: copy this file to `.env` next to it. The stack runs
# without it.
#
# Secret for signing access tokens, at least 32 characters. Left empty, the API generates a
# random one on the first start and keeps it in the api-data volume. To set your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -hex 32
JWT_SECRET=

# Token lifetime: 15m, 12h, 7d, ...
JWT_EXPIRES_IN=7d
