# Settings for docker-compose.yml. Copy this file to `.env` (next to docker-compose.yml).
#
# Secret for signing access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetime: 15m, 12h, 7d, ...
JWT_EXPIRES_IN=7d
