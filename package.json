{
  "name": "todo-list-senamasoft",
  "version": "1.0.0",
  "private": true,
  "description": "Todo list: Express + MongoDB API, React web client and Expo mobile app",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "npm run build -w @todo/shared",
    "dev": "concurrently -k -n shared,api,web -c gray,blue,magenta \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @todo/shared",
    "dev:server": "npm run dev -w @todo/server",
    "dev:web": "npm run dev -w @todo/web",
    "dev:mobile": "npm run start -w @todo/mobile",
    "db:memory": "npm run db:memory -w @todo/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
